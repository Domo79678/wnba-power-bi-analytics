# Copy this file to .env for local development.

# ESPN's public WNBA scoreboard endpoint. No API key is currently required.
WNBA_SCOREBOARD_URL=https://site.api.espn.com/apis/site/v2/sports/basketball/wnba/scoreboard

# Stop waiting if ESPN does not respond within this many seconds.
WNBA_API_TIMEOUT_SECONDS=30
