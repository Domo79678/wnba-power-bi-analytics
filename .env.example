# Copy this file to .env for local development.
# This scaffold does not contact an API, so these values are placeholders.

# Base URL of the WNBA data source selected in a future project stage.
WNBA_API_BASE_URL=https://example.invalid

# Leave blank when the future data source does not require authentication.
WNBA_API_KEY=

# HTTP timeout in seconds for future API requests.
WNBA_API_TIMEOUT_SECONDS=30
